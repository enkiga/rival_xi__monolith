# Copy to backend/.env for Docker and direct backend runs.
# Production copies should set this to ./backend/.env.prod.
BACKEND_ENV_FILE=./backend/.env
# Use the asyncpg driver. Production should use its external database hostname.
DATABASE_URL=postgresql+asyncpg://rivalxi:change-me@localhost:5432/rivalxi
# Docker reaches a database on your computer through host.docker.internal.
# Omit this override when DATABASE_URL is already reachable from containers.
DOCKER_DATABASE_URL=postgresql+asyncpg://rivalxi:change-me@host.docker.internal:5432/rivalxi
GAMEWEEK_SYNC_INTERVAL_MINUTES=5
REDIS_URL=redis://localhost:6379

# Dev defaults to port 8000; production defaults to 8001.
# BACKEND_PORT=8000
# Bound to localhost by default. Set deliberately for remote access.
BACKEND_BIND_ADDRESS=127.0.0.1

FPL_REQUEST_INTERVAL_MS=2000
FPL_MAX_RETRIES=3

FPL_BOOTSTRAP_CACHE_TTL=300
FPL_ENTRY_CACHE_TTL=600
FPL_LIVE_CACHE_TTL=120
FPL_PICKS_CACHE_TTL=120

LIVE_GAMEWEEK_CACHE_TTL=30
FINAL_GAMEWEEK_CACHE_TTL=86400

# Generate the Auth secret key using 'python3 -c "import secrets; print(secrets.token_hex(32))"'
AUTH_OTP_SECRET=replace-with-a-long-random-secret

AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_COOKIE_NAME=rivalxi_session
# Have Auth Secure cookies in production. Set to true when using HTTPS.
AUTH_COOKIE_SECURE=false

AUTH_RATE_LIMIT_WINDOW_SECONDS=900

AUTH_OTP_REQUEST_EMAIL_LIMIT=5
AUTH_OTP_REQUEST_IP_LIMIT=20

AUTH_OTP_VERIFY_EMAIL_LIMIT=10
AUTH_OTP_VERIFY_IP_LIMIT=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Trust forwarded client addresses only from these proxy IPs or CIDRs.
# Replace this with the exact production reverse-proxy address when needed.
FORWARDED_ALLOW_IPS=127.0.0.1
