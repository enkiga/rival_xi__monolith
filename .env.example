# Copy to .env.dev or .env.prod and use the matching --env-file option.
# Containers use host.docker.internal to reach PostgreSQL on your machine.
# Production should use its external database hostname and credentials.
DATABASE_URL=postgresql+asyncpg://rivalxi:change-me@host.docker.internal:5432/rivalxi
GAMEWEEK_SYNC_INTERVAL_MINUTES=5

# Dev defaults to port 8000; production defaults to 8001.
# BACKEND_PORT=8000
# Bound to localhost by default. Set deliberately for remote access.
BACKEND_BIND_ADDRESS=127.0.0.1
