# Copy to .env at the repository root for Docker and direct backend runs.
# Use the asyncpg driver. Production should use its external database hostname.
DATABASE_URL=postgresql+asyncpg://rivalxi:change-me@localhost:5432/rivalxi
# Docker reaches a database on your computer through host.docker.internal.
# Omit this override when DATABASE_URL is already reachable from containers.
DOCKER_DATABASE_URL=postgresql+asyncpg://rivalxi:change-me@host.docker.internal:5432/rivalxi
GAMEWEEK_SYNC_INTERVAL_MINUTES=5

# Dev defaults to port 8000; production defaults to 8001.
# BACKEND_PORT=8000
# Bound to localhost by default. Set deliberately for remote access.
BACKEND_BIND_ADDRESS=127.0.0.1
